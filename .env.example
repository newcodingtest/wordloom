# Subdomain only: wordloom-example -> https://wordloom-example.duckdns.org
DUCKDNS_SUBDOMAIN=wordloom-example
DUCKDNS_TOKEN=replace-with-your-duckdns-token
# Required when issuing a Let's Encrypt certificate.
LETSENCRYPT_EMAIL=you@example.com
# Optional: default is ${DUCKDNS_SUBDOMAIN}.duckdns.org.
# To use your own domain later, point its DNS to the server before setting it.
# DOMAIN=wordloom.example.com
